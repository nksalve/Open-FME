{
  "name": "01_Customer_Spatial_Profiling",
  "version": "1.0.0",
  "nodes": [
    {
      "id": "2ea8c691-20e9-4936-af5c-c9a667b5a086",
      "node_type": "CSVReader",
      "custom_name": "CSV Reader",
      "position": {
        "x": 100.0,
        "y": 160.0
      },
      "params": {
        "file_path": "C:\\Users\\Bisag\\Documents\\GitHub\\Open-FME\\sample_data\\customers.csv",
        "delimiter": ",",
        "has_header": true,
        "ignore_errors": true
      }
    },
    {
      "id": "b4bdc98f-9251-4098-9e8d-f7f367e0e7e6",
      "node_type": "Tester",
      "custom_name": "Tester",
      "position": {
        "x": 360.0,
        "y": 160.0
      },
      "params": {
        "attribute": "status",
        "operator": "=",
        "test_value": "active"
      }
    },
    {
      "id": "2ea6be98-fa7d-415f-b02a-c57d1a00b30c",
      "node_type": "VertexCreator",
      "custom_name": "Vertex Creator",
      "position": {
        "x": 650.0,
        "y": 160.0
      },
      "params": {
        "x_attribute": "lon",
        "y_attribute": "lat",
        "crs": "EPSG:4326"
      }
    },
    {
      "id": "1fef7466-bb25-44c4-8149-f24ed43ff37a",
      "node_type": "Bufferer",
      "custom_name": "Bufferer",
      "position": {
        "x": 910.0,
        "y": 160.0
      },
      "params": {
        "buffer_distance": 0.25,
        "resolution": 16
      }
    },
    {
      "id": "b102dc92-ddac-4355-abe5-f62583841621",
      "node_type": "GeoJSONWriter",
      "custom_name": "GeoJSON Writer",
      "position": {
        "x": 1190.0,
        "y": 160.0
      },
      "params": {
        "file_path": "C:\\Users\\Bisag\\Documents\\GitHub\\Open-FME\\sample_data\\active_customers_buffered.geojson"
      }
    }
  ],
