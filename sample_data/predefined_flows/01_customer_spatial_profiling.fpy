{
  "name": "01_Customer_Spatial_Profiling",
  "version": "1.0.0",
  "nodes": [
    {
      "id": "f79f0665-4b6b-4772-8efa-7f6faf7f4cf9",
      "node_type": "CSVReader",
      "custom_name": "CSV Reader",
      "position": {
        "x": 100.0,
        "y": 160.0
      },
      "params": {
        "file_path": "C:\\Users\\Bisag\\Documents\\GitHub\\Open-FME\\sample_data\\customers.csv",
        "delimiter": ",",
        "has_header": true,
        "ignore_errors": true
      }
    },
    {
      "id": "582dbb88-7b6c-4344-8310-a85c75fa7202",
      "node_type": "Tester",
      "custom_name": "Tester",
      "position": {
        "x": 360.0,
        "y": 160.0
      },
      "params": {
        "attribute": "status",
        "operator": "=",
        "test_value": "active"
      }
    },
    {
      "id": "1c48bfca-a93a-4b28-8061-ed4897585fa9",
      "node_type": "VertexCreator",
      "custom_name": "Vertex Creator",
      "position": {
        "x": 650.0,
        "y": 160.0
      },
      "params": {
        "x_attribute": "lon",
        "y_attribute": "lat",
        "crs": "EPSG:4326"
      }
    },
    {
      "id": "0777bd8b-5d26-4611-9f9c-df1f14c2df2c",
      "node_type": "Bufferer",
      "custom_name": "Bufferer",
      "position": {
        "x": 910.0,
        "y": 160.0
      },
      "params": {
        "buffer_distance": 0.25,
        "resolution": 16
      }
    },
    {
      "id": "4a1ad37b-de43-4a9b-94c6-c53bdf8d9a51",
      "node_type": "GeoJSONWriter",
