{
  "name": "01_Customer_Spatial_Profiling",
  "version": "1.0.0",
  "nodes": [
    {
      "id": "eb197105-c6e5-45f8-bd21-50e25a9814e5",
      "node_type": "CSVReader",
      "custom_name": "CSV Reader",
      "position": {
        "x": 100.0,
        "y": 180.0
      },
      "params": {
        "file_path": "C:\\Users\\Bisag\\Documents\\GitHub\\Open-FME\\sample_data\\customers.csv",
        "delimiter": ",",
        "has_header": true,
        "ignore_errors": true
      }
    },
    {
      "id": "dc47c5a6-59bd-4684-932c-868e3c8a843c",
      "node_type": "Tester",
      "custom_name": "Tester",
      "position": {
        "x": 360.0,
        "y": 180.0
      },
      "params": {
        "attribute": "status",
        "operator": "=",
        "test_value": "active"
      }
    },
    {
      "id": "a94f1d6a-9bfd-4d43-acf7-d40e28416078",
      "node_type": "VertexCreator",
      "custom_name": "Vertex Creator",
      "position": {
        "x": 620.0,
        "y": 140.0
      },
      "params": {
        "x_attribute": "lon",
        "y_attribute": "lat",
        "crs": "EPSG:4326"
      }
    },
    {
      "id": "fcf1f395-4e1a-4354-943c-e0ce9fc0e323",
      "node_type": "Bufferer",
      "custom_name": "Bufferer",
      "position": {
        "x": 880.0,
        "y": 140.0
      },
      "params": {
        "buffer_distance": 0.25,
        "resolution": 16
      }
    },
    {
      "id": "5c86d92f-bb06-4825-9f4b-7b89abb22462",
      "node_type": "GeoJSONWriter",
      "custom_name": "GeoJSON Writer",
